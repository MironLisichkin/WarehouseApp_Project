<Window x:Class="WarehouseApp.UI.Views.WarehousesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WarehouseApp.UI.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="600" Width="1000"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Закрыть" Click="CloseButton_Click"/>
            </MenuItem>
            <MenuItem Header="Склады">
                <MenuItem Header="Новый склад" Command="{Binding AddCommand}"/>
                <MenuItem Header="Изменить склад" Command="{Binding EditCommand}"/>
                <MenuItem Header="Удалить склад" Command="{Binding DeleteCommand}"/>
            </MenuItem>

            <MenuItem Header="Товары">
                <MenuItem Header="Добавить товар" Command="{Binding AddProductCommand}"/>
                <MenuItem Header="Редактировать товар" Command="{Binding EditProductCommand}"/>
                <MenuItem Header="Удалить товар" Command="{Binding DeleteProductCommand}"/>
            </MenuItem>

            <MenuItem Header="Накладные">
                <MenuItem Header="Открыть список накладных" Command="{Binding ShowInvoicesCommand}"/>
                <Separator/>
                <MenuItem Header="Создать накладную (Приход)" Command="{Binding CreateIncomingCommand}"/>
                <MenuItem Header="Создать накладную (Расход)" Command="{Binding CreateOutgoingCommand}"/>
            </MenuItem>

            <MenuItem Header="Справочники">
                <MenuItem Header="Организации" Command="{Binding OpenOrganizationsCommand}"/>
                <Separator/>
                <MenuItem Header="Склады (Список)" Command="{Binding FocusWarehousesCommand}"/>
                <MenuItem Header="Товары (Таблица)" Command="{Binding FocusProductsCommand}"/>
            </MenuItem>

        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" ItemsSource="{Binding Warehouses}" 
                      SelectedItem="{Binding SelectedWarehouse}" Margin="5">
                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="5,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="IsHitTestVisible" Value="False"/>
                    </Style>
                </ListView.Resources>
                
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Новый склад" Command="{Binding AddCommand}"/>
                        <MenuItem Header="Изменить склад" Command="{Binding EditCommand}"/>
                        <MenuItem Header="Удалить склад" Command="{Binding DeleteCommand}"/>
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Склады" DisplayMemberBinding="{Binding Name}" Width="220"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Width="200" Height="25" VerticalContentAlignment="Center" 
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding ProductsView}" SelectedItem="{Binding SelectedProduct}" 
                            AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Фото" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding PhotoPath}" Stretch="Uniform" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="100"/>
                        <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="100"/>
                        <DataGridTextColumn Header="Поставщик" Binding="{Binding Supplier}" Width="100"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="80"/>
                        <DataGridTextColumn Header="Остаток" Binding="{Binding Stock}" Width="80"/>
                        <DataGridTextColumn Header="Скидка %" Binding="{Binding DiscountPercent}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</Window>
